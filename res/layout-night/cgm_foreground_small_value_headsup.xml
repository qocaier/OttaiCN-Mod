<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@id/foregroundLayout"
    android:background="@android:color/transparent"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="14.0dip"
        android:textColor="#ffffffff"
        android:gravity="right"
        android:id="@id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <TextView
        android:textSize="32.0dip"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:gravity="end"
        android:id="@id/glucose"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_weight="1.0" />
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4.0dip">
        <ImageView
            android:id="@id/trend_up"
            android:visibility="invisible"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:layout_marginTop="2.0dip"
            android:src="@drawable/dark_up" />
        <ImageView
            android:id="@id/trend_up_little"
            android:visibility="invisible"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:layout_marginTop="2.0dip"
            android:src="@drawable/dark_up_little" />
        <ImageView
            android:id="@id/trend_normal"
            android:visibility="invisible"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:layout_marginTop="2.0dip"
            android:src="@drawable/dark_normal" />
        <ImageView
            android:id="@id/trend_down_little"
            android:visibility="invisible"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:layout_marginTop="2.0dip"
            android:src="@drawable/dark_down_little" />
        <ImageView
            android:id="@id/trend_down"
            android:visibility="invisible"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:layout_marginTop="2.0dip"
            android:src="@drawable/dark_down" />
        <ImageView
            android:id="@id/trend_up_large"
            android:visibility="invisible"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:layout_marginTop="2.0dip"
            android:src="@drawable/up_large" />
        <ImageView
            android:id="@id/trend_down_large"
            android:visibility="invisible"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:layout_marginTop="2.0dip"
            android:src="@drawable/down_large" />
        <TextView
            android:textSize="12.0dip"
            android:textColor="#ffffffff"
            android:id="@id/glucoseUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14.0dip" />
    </FrameLayout>
</LinearLayout>