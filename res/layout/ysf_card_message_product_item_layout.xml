<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:layout_width="fill_parent"
        android:layout_height="8.0dip" />
    <include
        layout="@layout/ysf_include_divider" />
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip">
        <ImageView
            android:id="@id/ysf_card_message_product_item_iv"
            android:layout_width="80.0dip"
            android:layout_height="80.0dip"
            android:scaleType="centerCrop" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="80.0dip"
            android:layout_marginLeft="8.0dip">
            <TextView
                android:textSize="12.0sp"
                android:textColor="@color/ysf_black_222222"
                android:ellipsize="end"
                android:id="@id/ysf_card_message_product_item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2" />
            <TextView
                android:textSize="10.0sp"
                android:ellipsize="end"
                android:id="@id/ysf_card_message_product_item_desc"
                android:paddingTop="2.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2" />
            <View
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0" />
            <TextView
                android:textSize="10.0sp"
                android:textColor="#ffff4000"
                android:id="@id/ysf_card_message_product_item_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>