<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="#33000000"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:background="@drawable/ysf_evaluation_dialog_header"
        android:layout_width="fill_parent"
        android:layout_height="48.0dip"
        android:layout_marginTop="120.0dip">
        <TextView
            android:textSize="@dimen/ysf_text_size_16"
            android:textColor="@color/ysf_black_222222"
            android:layout_gravity="center_vertical"
            android:id="@id/ysf_consultation_scope_title"
            android:paddingLeft="16.0dip"
            android:paddingRight="16.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ysf_select_consultation_scope"
            android:paddingHorizontal="16.0dip" />
        <ImageView
            android:layout_gravity="end|center"
            android:id="@id/ysf_consultation_scope_close"
            android:background="@drawable/ysf_ic_dialog_close"
            android:layout_width="20.0dip"
            android:layout_height="20.0dip"
            android:layout_marginRight="16.0dip"
            android:contentDescription="@null" />
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/ysf_white"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <include
            android:id="@id/ysf_consultation_scope_view1"
            layout="@layout/ysf_include_divider" />
        <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textSize="@dimen/ysf_text_size_14"
                android:textColor="@color/ysf_black_333333"
                android:textColorHint="@color/ysf_grey_999999"
                android:id="@id/ysf_consultation_scope_search"
                android:background="@drawable/ysf_evaluation_remark_border"
                android:paddingLeft="8.0dip"
                android:paddingTop="10.0dip"
                android:paddingBottom="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginLeft="16.0dip"
                android:layout_marginTop="10.0dip"
                android:layout_marginRight="16.0dip"
                android:layout_marginBottom="10.0dip"
                android:hint="@string/ysf_consultation_scope_search_placeholder"
                android:maxLines="1"
                android:drawableLeft="@drawable/ysf_ic_search_icon"
                android:drawablePadding="8.0dip"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:layout_marginHorizontal="16.0dip"
                android:layout_marginVertical="10.0dip"
                android:paddingVertical="10.0dip" />
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:paddingLeft="16.0dip"
                android:paddingRight="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:paddingHorizontal="16.0dip">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/ysf_tab_selected"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent">
                    <TextView
                        android:textSize="@dimen/ysf_text_size_14"
                        android:textColor="@color/ysf_blue_337EFF"
                        android:gravity="center"
                        android:id="@id/ysf_tab_selected_text"
                        android:paddingLeft="8.0dip"
                        android:paddingRight="8.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="0.0dip"
                        android:text="@string/ysf_selected_tab"
                        android:layout_weight="1.0"
                        android:paddingHorizontal="8.0dip" />
                    <View
                        android:id="@id/ysf_tab_selected_indicator"
                        android:background="@color/ysf_blue_337EFF"
                        android:layout_width="fill_parent"
                        android:layout_height="2.0dip" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/ysf_tab_search_results"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_marginStart="16.0dip">
                    <TextView
                        android:textSize="@dimen/ysf_text_size_14"
                        android:textColor="@color/ysf_black_333333"
                        android:gravity="center"
                        android:id="@id/ysf_tab_search_results_text"
                        android:paddingLeft="8.0dip"
                        android:paddingRight="8.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="0.0dip"
                        android:text="@string/ysf_search_results_tab"
                        android:layout_weight="1.0"
                        android:paddingHorizontal="8.0dip" />
                    <View
                        android:id="@id/ysf_tab_search_results_indicator"
                        android:background="@color/ysf_blue_337EFF"
                        android:visibility="invisible"
                        android:layout_width="fill_parent"
                        android:layout_height="2.0dip" />
                </LinearLayout>
            </LinearLayout>
            <include
                android:id="@id/ysf_consultation_scope_view2"
                layout="@layout/ysf_include_divider" />
            <FrameLayout
                android:paddingLeft="16.0dip"
                android:paddingRight="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0"
                android:paddingHorizontal="16.0dip">
                <ListView
                    android:id="@id/ysf_consultation_scope_list"
                    android:scrollbars="none"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:listSelector="@color/ysf_grey_e6e6e6"
                    android:divider="@color/ysf_grey_e6e6e6"
                    android:dividerHeight="1.0dip" />
                <TextView
                    android:textSize="@dimen/ysf_text_size_14"
                    android:textColor="@color/ysf_grey_999999"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/ysf_consultation_scope_empty"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ysf_consultation_scope_no_selected" />
            </FrameLayout>
            <include
                android:id="@id/ysf_consultation_scope_view3"
                layout="@layout/ysf_include_divider" />
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="16.0dip"
                android:paddingRight="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="56.0dip"
                android:paddingHorizontal="16.0dip">
                <TextView
                    android:textSize="@dimen/ysf_text_size_14"
                    android:textColor="@color/ysf_grey_666666"
                    android:gravity="center"
                    android:id="@id/ysf_consultation_scope_cancel"
                    android:background="@drawable/ysf_evaluation_tag_bg_selector"
                    android:layout_width="0.0dip"
                    android:layout_height="40.0dip"
                    android:text="@string/ysf_cancel"
                    android:layout_weight="1.0"
                    android:layout_marginEnd="8.0dip" />
                <TextView
                    android:textSize="@dimen/ysf_text_size_14"
                    android:textColor="@color/ysf_white"
                    android:gravity="center"
                    android:id="@id/ysf_consultation_scope_confirm"
                    android:background="@drawable/ysf_evaluation_bubble_btn_submit_bg_selector"
                    android:layout_width="0.0dip"
                    android:layout_height="40.0dip"
                    android:text="@string/ysf_ok"
                    android:layout_weight="1.0"
                    android:layout_marginStart="8.0dip" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>