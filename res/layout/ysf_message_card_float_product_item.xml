<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/ysf_card_float_product_ll"
    android:background="@drawable/ysf_bg_bot_product_detail_dialog"
    android:layout_width="150.0dip"
    android:layout_height="wrap_content"
    android:layout_margin="4.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/ysf_card_float_product_iv"
        android:layout_width="150.0dip"
        android:layout_height="150.0dip"
        android:scaleType="centerCrop" />
    <TextView
        android:textSize="16.0dip"
        android:ellipsize="end"
        android:id="@id/ysf_card_float_product_title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.0dip"
        android:lines="2" />
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.0dip">
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ffff4000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/ysf_card_float_product_price"
            android:layout_width="50.0dip"
            android:layout_height="wrap_content"
            android:maxLines="1" />
        <TextView
            android:textSize="14.0sp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/ysf_card_float_product_desc"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:maxLines="1"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>