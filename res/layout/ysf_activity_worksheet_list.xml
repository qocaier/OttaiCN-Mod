<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/ysf_ll_work_sheet_list_parent"
    android:background="@color/ysf_white"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="45.0dip">
        <FrameLayout
            android:orientation="horizontal"
            android:background="@drawable/ysf_grey_button_shape"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="12.0dip"
            android:layout_marginTop="7.0dip"
            android:layout_marginRight="12.0dip"
            android:layout_marginBottom="7.0dip"
            android:layout_weight="9.0"
            android:layout_marginHorizontal="12.0dip">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/ysf_iv_work_sheet_search_icon"
                android:background="@drawable/ysf_ic_search_icon"
                android:layout_width="18.0dip"
                android:layout_height="18.0dip"
                android:layout_marginLeft="12.0dip" />
            <EditText
                android:textSize="14.0sp"
                android:textColor="@color/ysf_black_333333"
                android:layout_gravity="center_vertical"
                android:id="@id/ysf_et_work_sheet_search"
                android:background="@android:color/transparent"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="47.0dip"
                android:layout_marginRight="30.0dip"
                android:hint="@string/ysf_work_sheet_input_type"
                android:singleLine="true"
                android:imeOptions="actionSearch" />
            <ImageView
                android:textSize="20.0sp"
                android:gravity="center_vertical"
                android:layout_gravity="center|right"
                android:id="@id/ysf_iv_work_sheet_search_delete"
                android:visibility="gone"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:layout_marginRight="12.0dip"
                android:src="@drawable/ysf_ic_delete_edit" />
        </FrameLayout>
        <com.qiyukf.unicorn.widget.TextSwitchView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@id/ysf_iv_work_sheet_tv_text_switch"
            android:layout_width="64.0dip"
            android:layout_height="28.0dip"
            android:layout_marginRight="12.0dip"
            app:closeColor="@color/ysf_blue_337EFF"
            app:closeText="@string/ysf_detailed"
            app:openColor="@color/ysf_blue_337EFF"
            app:openText="@string/ysf_concise" />
        <TextView
            android:textSize="16.0sp"
            android:textColor="@color/ysf_button_color_state_list"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@id/ysf_iv_work_sheet_search_cancel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12.0dip"
            android:text="@string/ysf_cancel" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@id/ysf_tv_work_sheet_list_total"
            android:paddingLeft="15.0dip"
            android:paddingTop="10.0dip"
            android:paddingBottom="10.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <View
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ysf_ll_work_sheet_status"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginLeft="10.0dip"
            android:layout_marginRight="10.0dip"
            android:layout_marginHorizontal="10.0dip">
            <TextView
                android:textSize="@dimen/ysf_text_size_12"
                android:textColor="@color/ysf_grey_999999"
                android:id="@id/ysf_tv_work_sheet_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="80.0dip"
                android:singleLine="true" />
            <ImageView
                android:gravity="center_vertical"
                android:id="@id/ysf_iv_work_sheet_status1"
                android:background="@drawable/ysf_ic_work_sheet_detail_unfold"
                android:layout_width="12.0dip"
                android:layout_height="8.0dip"
                android:layout_marginLeft="2.0dip"
                android:layout_marginTop="1.0dip" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ysf_ll_work_sheet_sort"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginRight="10.0dip">
            <TextView
                android:textSize="@dimen/ysf_text_size_12"
                android:textColor="@color/ysf_grey_999999"
                android:id="@id/ysf_tv_work_sheet_sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="80.0dip"
                android:singleLine="true" />
            <ImageView
                android:gravity="center_vertical"
                android:id="@id/ysf_iv_work_sheet_status2"
                android:background="@drawable/ysf_ic_work_sheet_detail_unfold"
                android:layout_width="12.0dip"
                android:layout_height="8.0dip"
                android:layout_marginLeft="2.0dip"
                android:layout_marginTop="1.0dip" />
        </LinearLayout>
    </LinearLayout>
    <com.qiyukf.unicorn.widget.pulltorefresh.PullToRefreshLayout
        android:orientation="vertical"
        android:id="@id/ysf_ptl_work_sheet_list_parent"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.qiyukf.unicorn.widget.pulltorefresh.PullableListView
            android:id="@id/ysf_pl_work_sheet_list"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:listSelector="@android:color/transparent"
            android:divider="@color/ysf_grey_dbdbdb"
            android:dividerHeight="0.5dip" />
    </com.qiyukf.unicorn.widget.pulltorefresh.PullToRefreshLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@id/ysf_tv_work_sheet_list_empty"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@id/ysf_iv_work_sheet_empty"
            android:background="@drawable/ic_emoji_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100.0dip"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@color/ysf_grey_cccccc"
            android:gravity="center"
            android:id="@id/ysf_tv_work_sheet_empty"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.0dip"
            android:text="@string/ysf_no_submit_record" />
    </LinearLayout>
</LinearLayout>