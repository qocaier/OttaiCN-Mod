<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/ysf_evaluation_dialog_header"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="@dimen/ysf_text_size_14"
        android:textColor="@color/ysf_black_222222"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@id/ysf_evaluation_again_dialog_text"
        android:paddingLeft="10.0dip"
        android:paddingRight="10.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40.0dip"
        android:maxLines="1"
        android:paddingHorizontal="10.0dip" />
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20.0dip"
        android:layout_marginBottom="40.0dip">
        <TextView
            android:textColor="@color/ysf_white"
            android:id="@id/ysf_evaluation_again_dialog_ok"
            android:background="@drawable/ysf_evaluation_button_bg"
            android:paddingLeft="16.0dip"
            android:paddingTop="8.0dip"
            android:paddingRight="16.0dip"
            android:paddingBottom="8.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8.0dip"
            android:text="@string/ysf_evaluation"
            android:paddingHorizontal="16.0dip"
            android:paddingVertical="8.0dip" />
        <TextView
            android:textColor="@color/ysf_black_333333"
            android:id="@id/ysf_evaluation_again_dialog_cancel"
            android:background="@drawable/ysf_bg_bot_dialog_cancel"
            android:paddingLeft="16.0dip"
            android:paddingTop="8.0dip"
            android:paddingRight="16.0dip"
            android:paddingBottom="8.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8.0dip"
            android:text="@string/ysf_cancel_give_up"
            android:paddingHorizontal="16.0dip"
            android:paddingVertical="8.0dip" />
    </LinearLayout>
</LinearLayout>