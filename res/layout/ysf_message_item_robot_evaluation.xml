<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/ysf_robot_evaluate_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        layout="@layout/ysf_include_divider" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ysf_robot_evaluation_tag_ll"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/ysf_line_color_e6e7eb"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="1.0dip" />
        <com.qiyukf.unicorn.widget.flowlayout.TagFlowLayout
            android:id="@id/ysf_robot_evaluation_tag_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="4.0dip"
            android:layout_marginRight="10.0dip"
            android:layout_marginHorizontal="10.0dip" />
        <EditText
            android:textSize="@dimen/ysf_text_size_12"
            android:textColor="@color/ysf_grey_666666"
            android:textColorHint="@color/ysf_grey_999999"
            android:ellipsize="end"
            android:gravity="top"
            android:id="@id/ysf_robot_evaluation_content"
            android:background="@drawable/ysf_message_robot_answer_evaluation_bg"
            android:paddingLeft="8.0dip"
            android:paddingTop="6.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="6.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12.0dip"
            android:layout_marginTop="12.0dip"
            android:layout_marginRight="12.0dip"
            android:layout_marginBottom="12.0dip"
            android:minHeight="60.0dip"
            android:hint="@string/ysf_message_robot_evaluation_hint"
            android:maxLines="3"
            android:paddingHorizontal="8.0dip"
            android:paddingVertical="6.0dip" />
        <include
            android:id="@id/ysf_robot_useful_divider"
            layout="@layout/ysf_include_divider" />
        <TextView
            android:enabled="false"
            android:textSize="@dimen/ysf_text_size_16"
            android:textColor="@drawable/ysf_btn_robot_bg_selector"
            android:gravity="center"
            android:id="@id/ysf_robot_evaluation_submit"
            android:paddingTop="8.0dip"
            android:paddingBottom="8.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/ysf_evaluation_bubble_btn_submit"
            android:paddingVertical="8.0dip" />
    </LinearLayout>
</LinearLayout>