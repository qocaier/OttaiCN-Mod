<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ysf_clickable_list_content"
        android:layout_width="@dimen/ysf_bubble_content_max_width"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ysf_clickable_list_normal"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/ysf_clickable_list_header"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/ysf_text_size_16"
                        android:textColor="@color/ysf_black_333333"
                        android:id="@id/ysf_clickable_list_header_text"
                        android:padding="12.0dip"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3.0dip"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@id/ysf_clickable_list_change_text"
                        app:layout_constraintTop_toTopOf="parent" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/ysf_clickable_list_header_more_linear"
                        android:visibility="gone"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@id/ysf_clickable_list_header_text"
                        app:layout_constraintLeft_toLeftOf="@id/ysf_clickable_list_header_text"
                        app:layout_constraintRight_toRightOf="@id/ysf_clickable_list_header_text">
                        <View
                            android:background="@drawable/ysf_back_evaluator_gradient"
                            android:layout_width="fill_parent"
                            android:layout_height="40.0dip" />
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:background="@color/ysf_white"
                            android:layout_width="fill_parent"
                            android:layout_height="30.0dip"
                            android:layout_marginLeft="12.0dip"
                            android:layout_marginRight="12.0dip"
                            android:layout_marginHorizontal="12.0dip">
                            <TextView
                                android:textSize="@dimen/ysf_text_size_14"
                                android:textColor="@color/ysf_grey_999999"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ysf_see_more" />
                            <ImageView
                                android:layout_width="15.0dip"
                                android:layout_height="15.0dip"
                                android:src="@drawable/ysf_ic_robot_arrow_right" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/ysf_text_size_14"
                        android:textColor="@color/ysf_grey_999999"
                        android:id="@id/ysf_clickable_list_change_text"
                        android:paddingLeft="10.0dip"
                        android:paddingTop="12.0dip"
                        android:paddingRight="10.0dip"
                        android:paddingBottom="12.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ysf_change"
                        android:drawableLeft="@drawable/ysf_ic_change"
                        android:drawablePadding="5.0dip"
                        android:paddingHorizontal="10.0dip"
                        android:paddingVertical="12.0dip"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <include
                    android:id="@id/ysf_clickable_list_header_divider"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/ysf_divider_height"
                    layout="@layout/ysf_include_divider" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/ysf_clickable_list_container"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip"
                android:layout_marginBottom="12.0dip" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/ysf_clickable_list_footer"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@id/ysf_clickable_list_footer_divider"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/ysf_divider_height"
                    layout="@layout/ysf_include_divider" />
                <TextView
                    android:textSize="@dimen/ysf_text_size_16"
                    android:textColor="@color/ysf_black_333333"
                    android:id="@id/ysf_clickable_list_footer_text"
                    android:paddingLeft="12.0dip"
                    android:paddingTop="10.0dip"
                    android:paddingRight="12.0dip"
                    android:paddingBottom="10.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/ysf_bubble_content_max_width" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ysf_clickable_list_category"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/ysf_text_size_16"
                android:textColor="@color/ysf_black_333333"
                android:id="@id/ysf_clickable_list_header_category"
                android:padding="12.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <HorizontalScrollView
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.qiyukf.unicorn.widget.tabLayout.PagerTabLayout
                    android:id="@id/ysf_robot_tab_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </HorizontalScrollView>
            <include
                layout="@layout/ysf_include_divider" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/ysf_ll_clickable_list_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/ysf_robot_evaluate_parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5.0dip"
        android:layout_marginTop="5.0dip">
        <FrameLayout
            android:id="@id/ysf_robot_evaluate_useful"
            android:background="@drawable/ysf_bg_bot_evaluation_use"
            android:paddingTop="5.0dip"
            android:paddingBottom="5.0dip"
            android:layout_width="80.0dip"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/ysf_text_size_15"
                android:textColor="@color/ysf_robot_evaluate_text_selector"
                android:layout_gravity="center"
                android:id="@id/ysf_robot_evaluate_useful_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ysf_robot_answer_useful"
                android:drawableLeft="@drawable/ysf_ic_robot_useful_selector"
                android:drawablePadding="4.0dip" />
        </FrameLayout>
        <FrameLayout
            android:id="@id/ysf_robot_evaluate_useless"
            android:background="@drawable/ysf_bg_bot_evaluation_use"
            android:paddingTop="5.0dip"
            android:paddingBottom="5.0dip"
            android:layout_width="80.0dip"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5.0dip">
            <TextView
                android:textSize="@dimen/ysf_text_size_15"
                android:textColor="@color/ysf_robot_evaluate_text_selector"
                android:layout_gravity="center"
                android:id="@id/ysf_robot_evaluate_useless_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ysf_robot_answer_useless"
                android:drawableLeft="@drawable/ysf_ic_robot_useless_selector"
                android:drawablePadding="4.0dip" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>