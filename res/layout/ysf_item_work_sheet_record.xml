<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/ysf_white"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16.0sp"
            android:textColor="@color/ysf_black_222222"
            android:ellipsize="end"
            android:id="@id/ysf_tv_work_sheet_detail_record_operator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16.0dip"
            android:layout_marginTop="14.0dip"
            android:layout_marginBottom="14.0dip"
            android:maxWidth="80.0dip"
            android:text="@string/ysf_custom_field"
            android:singleLine="true" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@color/ysf_grey_999999"
            android:ellipsize="end"
            android:id="@id/ysf_tv_work_sheet_detail_record_people"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16.0dip"
            android:layout_marginTop="14.0dip"
            android:layout_marginBottom="14.0dip"
            android:maxWidth="50.0dip"
            android:singleLine="true"
            android:layout_alignParentRight="true" />
        <View
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@color/ysf_yellow_ff9900"
            android:ellipsize="end"
            android:gravity="right"
            android:id="@id/ysf_tv_work_sheet_detail_record_append"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14.0dip"
            android:layout_marginRight="16.0dip"
            android:layout_marginBottom="14.0dip"
            android:maxWidth="100.0dip"
            android:text="@string/ysf_need_append_file_info"
            android:singleLine="true"
            android:drawableLeft="@drawable/ysf_ic_work_sheet_append"
            android:drawablePadding="4.0dip"
            android:layout_toRightOf="@id/ysf_tv_work_sheet_detail_custom_field_tag"
            android:layout_alignParentRight="true" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@color/ysf_grey_999999"
            android:ellipsize="end"
            android:gravity="right"
            android:id="@id/ysf_tv_work_sheet_detail_record_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14.0dip"
            android:layout_marginRight="16.0dip"
            android:layout_marginBottom="14.0dip"
            android:singleLine="true"
            android:layout_toRightOf="@id/ysf_tv_work_sheet_detail_custom_field_tag"
            android:layout_alignParentRight="true" />
    </LinearLayout>
    <com.qiyukf.unicorn.widget.foldtextview.FoldSelfTextView
        android:textSize="14.0sp"
        android:textColor="@color/ysf_black_333333"
        android:ellipsize="none"
        android:id="@id/ysf_work_sheet_content_body"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16.0dip"
        android:layout_marginTop="10.0dip"
        android:layout_marginRight="16.0dip"
        android:layout_marginBottom="14.0dip"
        android:maxLines="5"
        android:layout_marginHorizontal="16.0dip" />
    <com.qiyukf.unicorn.ui.worksheet.WorkSheetAttachPreviewLayout
        android:id="@id/ysf_work_sheet_content_attach"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16.0dip"
        android:layout_marginRight="16.0dip"
        android:layout_marginBottom="14.0dip"
        android:layout_marginHorizontal="16.0dip" />
    <include
        android:layout_width="fill_parent"
        android:layout_height="@dimen/ysf_divider_height"
        android:layout_marginLeft="16.0dip"
        android:layout_marginRight="16.0dip"
        android:layout_marginHorizontal="16.0dip"
        layout="@layout/ysf_include_divider" />
</LinearLayout>