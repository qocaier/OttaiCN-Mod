<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:layout_gravity="center"
        android:id="@id/ysf_unsupport_preview_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <TextView
        android:textSize="@dimen/ysf_text_size_16sp"
        android:textColor="@color/ysf_black_333333"
        android:ellipsize="middle"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/ysf_unsupport_file_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20.0dip"
        android:layout_marginTop="16.0dip"
        android:layout_marginRight="20.0dip"
        android:maxLines="2" />
    <Button
        android:textSize="@dimen/ysf_text_size_16sp"
        android:textColor="@color/ysf_white"
        android:layout_gravity="center"
        android:id="@id/ysf_unsupport_download_btn"
        android:background="@color/ysf_blue_337EFF"
        android:layout_width="200.0dip"
        android:layout_height="40.0dip"
        android:layout_marginTop="24.0dip"
        android:text="@string/ysf_see_more" />
</LinearLayout>