<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="#33000000"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@id/ysf_ysf_work_sheet_info_parent"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="120.0dip">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <FrameLayout
                android:id="@id/ysf_work_sheet_info_fl"
                android:background="@drawable/ysf_evaluation_dialog_header"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="fill_parent"
                android:layout_height="50.0dip"
                android:layout_above="@id/ysf_sl_work_sheet_list_parent">
                <TextView
                    android:textSize="@dimen/ysf_text_size_16sp"
                    android:textColor="@color/ysf_black_333333"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@id/ysf_work_sheet_category_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16.0dip"
                    android:layout_marginRight="30.0dip"
                    android:text="@string/ysf_input_info_str"
                    android:singleLine="true" />
                <ImageView
                    android:layout_gravity="end|center"
                    android:id="@id/ysf_work_sheet_category_close"
                    android:padding="12.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4.0dip"
                    android:src="@drawable/ysf_ic_dialog_close"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/ysf_white"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_alignParentBottom="true">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/ysf_ll_work_sheet_category"
                    android:layout_width="fill_parent"
                    android:layout_height="44.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginBottom="10.0dip" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="0.0dip"
                    android:layout_weight="1.0">
                    <ListView
                        android:id="@id/ysf_lv_work_sheet_select"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:drawSelectorOnTop="true"
                        android:cacheColorHint="@android:color/transparent"
                        android:divider="@null" />
                </LinearLayout>
                <TextView
                    android:id="@id/ysf_tv_work_sheet_category_summary"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="16.0dip"
                    android:layout_marginBottom="10.0dip"
                    android:layout_above="@id/ysf_btn_work_sheet_ok" />
                <Button
                    android:textSize="18.0sp"
                    android:id="@id/ysf_btn_work_sheet_ok"
                    android:background="@drawable/ysf_file_btn_bg"
                    android:layout_width="fill_parent"
                    android:layout_height="55.0dip"
                    android:layout_marginLeft="16.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="16.0dip"
                    android:layout_marginBottom="20.0dip"
                    android:text="@string/ysf_ok"
                    android:layout_alignParentBottom="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>