<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ysf_card_message_order_parent"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="10.0dip"
            android:paddingBottom="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10.0dip">
            <TextView
                android:textSize="12.0sp"
                android:ellipsize="end"
                android:id="@id/ysf_card_message_order_item_id"
                android:paddingRight="6.0dip"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:minWidth="10.0dip"
                android:maxLines="1"
                android:layout_weight="1.0" />
            <TextView
                android:textSize="12.0sp"
                android:ellipsize="end"
                android:id="@id/ysf_card_message_order_item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1" />
        </LinearLayout>
        <View
            android:id="@id/ysf_card_order_item_divider"
            android:background="@color/ysf_line_color_e6e7eb"
            android:layout_width="fill_parent"
            android:layout_height="0.5dip" />
        <TextView
            android:layout_gravity="right"
            android:id="@id/ysf_card_order_item_change"
            android:paddingTop="8.0dip"
            android:paddingRight="10.0dip"
            android:paddingBottom="8.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ysf_change"
            android:drawableLeft="@drawable/ysf_ic_change"
            android:drawablePadding="5.0dip"
            android:paddingVertical="8.0dip" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ysf_card_message_order_item"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>