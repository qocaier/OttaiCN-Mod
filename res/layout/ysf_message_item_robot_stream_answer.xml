<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/ysf_robot_stream_root"
    android:layout_width="@dimen/ysf_bubble_content_max_width"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ysf_robot_stream_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/ysf_robot_stream_progress_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.qiyukf.unicorn.widget.DotProgressBar
                android:id="@id/ysf_robot_stream_progress"
                android:layout_width="30.0dip"
                android:layout_height="12.0dip"
                android:layout_marginTop="4.0dip"
                app:amount="2"
                app:animationDirection="right"
                app:duration="600"
                app:endColor="@color/ysf_transparent_color"
                app:startColor="@color/ysf_blue_337EFF" />
            <TextView
                android:textSize="16.0sp"
                android:id="@id/ysf_robot_stream_progress_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2.0dip" />
        </LinearLayout>
        <TextView
            android:textSize="@dimen/ysf_text_size_16"
            android:textColor="@color/ysf_black_333333"
            android:id="@id/ysf_robot_stream_answer_text"
            android:padding="12.0dip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ysf_robot_stream_tag_ll"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <include
                layout="@layout/ysf_include_divider" />
            <com.qiyukf.unicorn.widget.flowlayout.TagFlowLayout
                android:id="@id/ysf_robot_stream_tag_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10.0dip"
                android:layout_marginTop="4.0dip"
                android:layout_marginRight="10.0dip"
                android:layout_marginHorizontal="10.0dip" />
            <EditText
                android:textSize="@dimen/ysf_text_size_12"
                android:textColor="@color/ysf_grey_666666"
                android:textColorHint="@color/ysf_grey_999999"
                android:ellipsize="end"
                android:gravity="top"
                android:id="@id/ysf_robot_stream_content"
                android:background="@drawable/ysf_message_robot_answer_evaluation_bg"
                android:paddingLeft="8.0dip"
                android:paddingTop="6.0dip"
                android:paddingRight="8.0dip"
                android:paddingBottom="6.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12.0dip"
                android:layout_marginTop="12.0dip"
                android:layout_marginRight="12.0dip"
                android:layout_marginBottom="12.0dip"
                android:minHeight="60.0dip"
                android:hint="@string/ysf_message_robot_evaluation_hint"
                android:maxLines="3"
                android:paddingHorizontal="8.0dip"
                android:paddingVertical="6.0dip" />
            <include
                android:id="@id/ysf_robot_useful_divider"
                layout="@layout/ysf_include_divider" />
            <TextView
                android:enabled="false"
                android:textSize="@dimen/ysf_text_size_16"
                android:textColor="@drawable/ysf_btn_robot_bg_selector"
                android:gravity="center"
                android:id="@id/ysf_robot_stream_submit"
                android:paddingTop="8.0dip"
                android:paddingBottom="8.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/ysf_evaluation_bubble_btn_submit"
                android:paddingVertical="8.0dip" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/ysf_robot_stream_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5.0dip"
        android:layout_marginTop="5.0dip">
        <FrameLayout
            android:id="@id/ysf_robot_stream_useful"
            android:background="@drawable/ysf_bg_bot_evaluation_use"
            android:paddingTop="5.0dip"
            android:paddingBottom="5.0dip"
            android:layout_width="80.0dip"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/ysf_text_size_15"
                android:textColor="@color/ysf_robot_evaluate_text_selector"
                android:layout_gravity="center"
                android:id="@id/ysf_robot_stream_useful_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ysf_robot_answer_useful"
                android:drawableLeft="@drawable/ysf_ic_robot_useful_selector"
                android:drawablePadding="4.0dip" />
        </FrameLayout>
        <FrameLayout
            android:id="@id/ysf_robot_stream_useless"
            android:background="@drawable/ysf_bg_bot_evaluation_use"
            android:paddingTop="5.0dip"
            android:paddingBottom="5.0dip"
            android:layout_width="80.0dip"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5.0dip">
            <TextView
                android:textSize="@dimen/ysf_text_size_15"
                android:textColor="@color/ysf_robot_evaluate_text_selector"
                android:layout_gravity="center"
                android:id="@id/ysf_robot_stream_useless_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ysf_robot_answer_useless"
                android:drawableLeft="@drawable/ysf_ic_robot_useless_selector"
                android:drawablePadding="4.0dip" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>