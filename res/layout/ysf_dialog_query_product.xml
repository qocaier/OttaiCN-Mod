<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/ysf_bg_bot_product_detail_dialog"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="480.0dip">
        <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="48.0dip">
            <TextView
                android:textSize="16.0sp"
                android:textColor="@color/ysf_black_333333"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@id/ysf_tv_dialog_query_product_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16.0dip"
                android:layout_marginRight="42.0dip"
                android:text="@string/ysf_query_product"
                android:maxLines="1" />
            <ImageView
                android:layout_gravity="center|right"
                android:id="@id/ysf_iv_dialog_query_product_close"
                android:layout_width="15.0dip"
                android:layout_height="15.0dip"
                android:layout_marginRight="16.0dip"
                android:src="@drawable/ysf_ic_dialog_close" />
        </FrameLayout>
        <include
            layout="@layout/ysf_include_divider" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ysf_ll_dialog_query_product_content"
            android:visibility="invisible"
            android:layout_width="fill_parent"
            android:layout_height="432.0dip">
            <HorizontalScrollView
                android:scrollbars="none"
                android:layout_width="fill_parent"
                android:layout_height="46.0dip">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/ysf_ll_dialog_query_product_tab_parent"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent" />
            </HorizontalScrollView>
            <ImageView
                android:id="@id/ysf_im_dialog_query_product_line"
                android:background="@color/ysf_blue_5092e1"
                android:layout_width="70.0dip"
                android:layout_height="3.0dip" />
            <include
                layout="@layout/ysf_include_divider" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/ysf_ll_dialog_query_product_search"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="45.0dip">
                <FrameLayout
                    android:orientation="horizontal"
                    android:background="@drawable/ysf_grey_button_shape"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="12.0dip"
                    android:layout_marginTop="7.0dip"
                    android:layout_marginRight="12.0dip"
                    android:layout_marginBottom="7.0dip"
                    android:layout_weight="9.0"
                    android:layout_marginHorizontal="12.0dip">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@id/ysf_iv_dialog_query_product_search_icon"
                        android:background="@drawable/ysf_ic_search_icon"
                        android:layout_width="18.0dip"
                        android:layout_height="18.0dip"
                        android:layout_marginLeft="12.0dip" />
                    <EditText
                        android:textSize="14.0sp"
                        android:textColor="@color/ysf_black_333333"
                        android:layout_gravity="center_vertical"
                        android:id="@id/ysf_et_dialog_query_product_search"
                        android:background="@android:color/transparent"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="47.0dip"
                        android:layout_marginRight="30.0dip"
                        android:hint="@string/ysf_please_input_str"
                        android:singleLine="true"
                        android:imeOptions="actionSearch" />
                    <ImageView
                        android:textSize="20.0sp"
                        android:gravity="center_vertical"
                        android:layout_gravity="center|right"
                        android:id="@id/ysf_iv_dialog_query_product_search_delete"
                        android:visibility="gone"
                        android:layout_width="20.0dip"
                        android:layout_height="20.0dip"
                        android:layout_marginRight="12.0dip"
                        android:src="@drawable/ysf_ic_delete_edit" />
                </FrameLayout>
                <TextView
                    android:textSize="16.0sp"
                    android:textColor="@color/ysf_button_color_state_list"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@id/ysf_iv_dialog_query_product_search_cancel"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12.0dip"
                    android:text="@string/ysf_cancel" />
            </LinearLayout>
            <com.qiyukf.unicorn.widget.ViewPagerFixed
                android:id="@id/ysf_vp_dialog_query_product"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent" />
        </LinearLayout>
        <TextView
            android:textSize="@dimen/ysf_text_size_14"
            android:textColor="@color/ysf_grey_999999"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@id/ysf_tv_dialog_product_list_empty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60.0dip"
            android:drawableTop="@drawable/ysf_ic_robot_query_product_empty"
            android:drawablePadding="10.0dip" />
    </LinearLayout>
</FrameLayout>