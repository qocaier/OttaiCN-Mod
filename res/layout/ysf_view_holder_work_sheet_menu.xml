<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="@color/ysf_white"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@id/ysf_tv_work_sheet_item_name"
        android:paddingLeft="16.0dip"
        android:paddingRight="58.0dip"
        android:layout_width="wrap_content"
        android:layout_height="58.0dip" />
    <ImageView
        android:layout_gravity="end|center"
        android:id="@id/ysf_iv_select"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="22.0dip"
        android:src="@drawable/ic_menu_selected"
        android:contentDescription="@null" />
    <include
        android:layout_gravity="bottom"
        android:id="@id/ysf_tv_work_sheet_item_divider"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/ysf_divider_height"
        layout="@layout/ysf_include_divider" />
</FrameLayout>