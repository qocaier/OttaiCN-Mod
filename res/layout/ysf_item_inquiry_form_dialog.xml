<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textColor="@color/ysf_black_333333"
        android:ellipsize="end"
        android:id="@id/ysf_tv_item_inquiry_form_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16.0dip"
        android:layout_marginRight="16.0dip"
        android:singleLine="true" />
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/ysf_rl_item_inquiry_form_input"
        android:background="@drawable/ysf_leave_msg_item_back"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16.0dip"
        android:layout_marginTop="5.0dip"
        android:layout_marginRight="16.0dip"
        android:layout_weight="1.0">
        <EditText
            android:textSize="14.0sp"
            android:textColor="@color/ysf_black_333333"
            android:ellipsize="end"
            android:id="@id/ysf_et_inquiry_form_item_content"
            android:background="@null"
            android:paddingTop="17.0dip"
            android:paddingBottom="17.0dip"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginLeft="17.0dip"
            android:singleLine="true"
            android:maxLength="100"
            android:layout_weight="1.0"
            android:imeOptions="actionNext"
            android:paddingVertical="17.0dip" />
        <ImageView
            android:id="@id/ysf_iv_inquiry_form_info_arrow"
            android:paddingLeft="17.0dip"
            android:paddingTop="15.0dip"
            android:paddingRight="17.0dip"
            android:paddingBottom="15.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ysf_ic_arrow_right"
            android:scaleType="center"
            android:paddingHorizontal="17.0dip"
            android:paddingVertical="15.0dip" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ysf_ll_inquiry_form_item_multiline_parent"
        android:background="@drawable/ysf_evaluation_remark_border"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="120.0dip"
        android:layout_marginLeft="16.0dip"
        android:layout_marginTop="15.0dip"
        android:layout_marginRight="16.0dip"
        android:layout_marginBottom="5.0dip"
        android:layout_weight="1.0">
        <com.qiyukf.unicorn.widget.ScrollEditText
            android:textSize="14.0sp"
            android:textColor="@color/ysf_black_333333"
            android:gravity="top"
            android:id="@id/ysf_et_inquiry_form_item_multiline"
            android:background="@null"
            android:padding="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:hint="@string/ysf_evaluation_dialog_et_hint_remark"
            android:maxLength="500"
            android:layout_weight="1.0"
            android:imeOptions="flagNoExtractUi" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="@color/ysf_grey_999999"
            android:gravity="right"
            android:id="@id/ysf_tv_inquiry_form_item_multiline_count"
            android:paddingRight="8.0dip"
            android:paddingBottom="4.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView
        android:textSize="14.0sp"
        android:textColor="@color/ysf_black_333333"
        android:ellipsize="end"
        android:gravity="right"
        android:id="@id/ysf_tv_leave_msg_info_value"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10.0dip"
        android:layout_marginRight="16.0dip"
        android:maxLines="1"
        android:layout_centerVertical="true" />
</LinearLayout>